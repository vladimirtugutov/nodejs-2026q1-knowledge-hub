PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# App
NODE_ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database URL
## for local DB
DATABASE_URL="postgresql://postgres:password@localhost:5432/knowledge_hub?schema=public"
## for Docker
#DATABASE_URL=postgresql://postgres:password@db:5432/knowledge_hub?schema=public

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024